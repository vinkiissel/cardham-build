# Copy to .env and fill in the values marked <...>.

# Domains. The frontend and API must share a parent domain, because the
# session cookie is SameSite=Strict, e.g. decks.example.com + api.example.com.
API_DOMAIN="api.example.com"
FRONTEND_URL="https://decks.example.com"
CORS_ORIGINS="https://decks.example.com"

# Postgres
POSTGRES_DB="arkham_build"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="<long random password>"

# Sessions. Generate with: openssl rand -hex 32
SESSION_SECRET="<64 random hex characters>"
ADMIN_API_KEY="<long random string>"

# Card data sources. Leave as-is to follow the official data repositories.
INGEST_JSON_DATA_REPO="Kamalisk/arkhamdb-json-data@master"
INGEST_METADATA_REPO="arkham-build/arkhamlcg-metadata@main"
INGEST_TABOO_DATA_REPO="fspoettel/arkham-cards-data@master"
METADATA_LOCALES="en"

# ArkhamDB deck guides are not imported on a private instance.
ENABLE_JOB_SCHEDULES="false"
INGEST_URL_ARKHAMDB_DECKLISTS="https://example.invalid"
LEGACY_API_BASE_URL="https://api-cf.arkham.build"

# ArkhamDB login is not used on a private instance.
ARKHAMDB_BASE_URL="https://arkhamdb.com"
ARKHAMDB_OAUTH_CLIENT_ID=""
ARKHAMDB_OAUTH_CLIENT_SECRET=""
ARKHAMDB_OAUTH_REDIRECT_URI="https://api.example.com/auth/callback"

# Email for account verification and password resets.
# Any SMTP provider works, e.g. a free tier of Brevo or a Gmail app password.
FROM_EMAIL="<sender address>"
FROM_NAME="Arkham deck builder"
SMTP_HOST="<smtp host>"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="<smtp user>"
SMTP_PASS="<smtp password>"

# Deck scan uploads (S3-compatible storage). Only needed for the scans feature;
# placeholder values let the API start without it.
SCANS_ACCESS_KEY_ID="unused"
SCANS_BUCKET="unused"
SCANS_ENDPOINT="https://example.invalid"
SCANS_SECRET_ACCESS_KEY="unused"

# Captcha on sign-up. Leave empty to disable.
TURNSTILE_SECRET_KEY=""
